<resources>
    <!-- 夜间启动主题：与 DarkLinguaPalette.paper(#171717) 对齐。
         系统深色下冷启动的首帧窗口背景是这里决定的；此前只有浅色主题
         （windowBackground 白），深色冷启动先白屏再变暗，即「闪白」缺陷。 -->
    <style name="Theme.LinguaReader" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">#171717</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#171717</item>
        <item name="android:statusBarColor">#171717</item>
    </style>
</resources>
