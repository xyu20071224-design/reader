    <string name="launch_update_note_title">What’s new in %1$s</string>
    <string name="launch_note_v4_1">Import EPUB, TXT, FB2 and text-based PDF books</string>
    <string name="launch_note_v4_2">Jump to a page within the current chapter</string>
    <string name="launch_note_v4_3">Fixed reading position lost on rotation and mis-matched phrase senses</string>
    <string name="launch_note_v4_4">Review reminders: three pace presets, context highlighting, toolbar badge, pause prompts</string>
    <string name="launch_note_v4_5">Diligent mode supports local due-word notifications (permission can be declined)</string>
    <string name="launch_note_v5_1">The launch greeting is now a four-period scene card</string>
    <string name="launch_note_v5_2">Added the late-night greeting</string>
    <string name="launch_note_v6_1">Listening: continuous narration of a chapter or whole book, in Chinese and English</string>
    <string name="launch_note_v6_2">The sentence being read is highlighted and pages turn automatically; tap a sentence to start there</string>
    <string name="launch_note_v6_3">Pause/resume, playback speed, background playback and notification controls</string>
    <string name="launch_note_v6_4">Listening progress is remembered per book — pick up where you left off</string>
    <string name="launch_note_v7_1">Fixed listening standby being stopped by the system in the background</string>
    <string name="launch_note_v7_2">Fixed intermittent loss of cloud TTS credentials and hardened decryption</string>
    <string name="launch_note_v7_3">Fixed narration highlight drifting in chapters with inline styles</string>
    <string name="launch_note_v7_4">Fixed playback stability: fast sentence switching, chapter skips, progress regressions</string>
    <string name="launch_note_v8_1">Fixed a crash while loading the system voice list on some engines</string>
    <string name="launch_note_v8_2">Hardened handling of getVoices() returning null or throwing</string>
    <string name="launch_note_v9_1">Brand-new offline narration engine: Chinese female and English male voices, no network needed</string>
    <string name="launch_note_v9_2">Fixed Piper spelling out rare words letter by letter</string>
    <string name="launch_note_v9_3">Switch freely between offline and system voices in the app</string>
    <string name="launch_note_v9_4">Rebuilt the playback state machine for steadier playback</string>
    <string name="launch_note_generic">Welcome to the new version — features and experience improved.</string>

